<cartridges:CompanionUiFragment xmlns:cartridges="clr-namespace:Content.Client._Horizon._Fractions.AnCo.CartridgeLoader.Cartridges"
                                xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                                xmlns="https://spacestation14.io"
                                Margin="1 0 2 0"

                                Orientation="Vertical"
                                HorizontalExpand="True"
                                VerticalExpand="True">
    <PanelContainer StyleClasses="BackgroundDark"></PanelContainer>
    <!-- Главный контейнер со всем контентом -->
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" VerticalExpand="True">

        <!-- Тут храниться основная информация о боргах и их количество -->
        <BoxContainer Name="MainStorage" Orientation="Vertical"
                      HorizontalExpand="True" VerticalExpand="True"
                      SizeFlagsStretchRatio="3" Margin="4">

            <controls:StripeBack HorizontalExpand="True">
                <BoxContainer Name="BorgDataInfo" Orientation="Vertical"
                      HorizontalExpand="True" VerticalExpand="True"
                      SizeFlagsStretchRatio="2" Margin="4">
                    <RichTextLabel Name="StatusLabel" HorizontalExpand="True" />
                    <RichTextLabel Name="BatteryLabel" HorizontalExpand="True" />
                    <RichTextLabel Name="MindLabel" HorizontalExpand="True" />
                    <RichTextLabel Name="ModulesLabel" HorizontalExpand="True" />
                </BoxContainer>
            </controls:StripeBack>

            <ScrollContainer HorizontalExpand="True" VerticalExpand="True" >
                <BoxContainer Name="BorgListContainer" Orientation="Vertical" />
            </ScrollContainer>
        </BoxContainer>


        <!-- Тут храниться выбранный борг и кнопки действий с ним -->
        <BoxContainer Name="DataStorage" Orientation="Vertical"
                      HorizontalExpand="True" VerticalExpand="True"
                      SizeFlagsStretchRatio="1" Margin="4" >

            <PanelContainer Name="BorgFrame" StyleClasses="BackgroundDark"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    MinSize="104 104" Margin="4">

                <SpriteView Name="CompanionSprite" Scale="3 3" OverrideDirection="South" />
            </PanelContainer>

            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True"
                          SizeFlagsStretchRatio="3">
                <Button HorizontalAlignment="Stretch" Name="DeleteCompanion" Text="Отвязать" />
                <Button HorizontalAlignment="Stretch" Name="ShutdownCompanion" Text="Отключить" />
                <Button HorizontalAlignment="Stretch" Name="CommandCompanion" Text="Команды" />
                <Button HorizontalAlignment="Stretch" Name="UpdateInfo" Text="Обновить" />
            </BoxContainer>

        </BoxContainer>

    </BoxContainer>
    <!-- Конец всего контента -->
</cartridges:CompanionUiFragment>
