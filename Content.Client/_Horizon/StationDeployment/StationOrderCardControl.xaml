<BoxContainer xmlns="https://spacestation14.io"
              xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls"
              Margin="10 10 10 0"
              HorizontalExpand="True"
              Visible="True">
    <PanelContainer StyleClasses="AngleRect" HorizontalExpand="True">
        <BoxContainer Orientation="Vertical"
                      HorizontalExpand="True"
                      Margin="5">
            <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                <TextureRect Name="CategoryTexture"
                             TextureScale="2 2"
                             VerticalAlignment="Center"
                             Margin="0 0 8 0"/>
                <RichTextLabel Name="CategoryLabel" VerticalAlignment="Center" HorizontalExpand="True"/>
                <Control MinWidth="10"/>
                <Button Name="CancelButton"
                        Text="{Loc 'station-task-console-cancel-button'}"
                        VerticalAlignment="Center"/>
            </BoxContainer>
            <customControls:HSeparator Margin="5 10 5 10"/>
            <BoxContainer Name="ManifestContainer" Orientation="Vertical" HorizontalExpand="True"/>
            <BoxContainer Margin="0 6 0 0">
                <RichTextLabel Name="DescriptionLabel"/>
            </BoxContainer>
        </BoxContainer>
    </PanelContainer>
</BoxContainer>
