<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      xmlns:derelict="clr-namespace:Content.Client._Horizon.Shipbreaking.Derelict"
                      Title="{Loc 'derelict-yard-title'}"
                      MinSize="900 560">
    <BoxContainer Orientation="Horizontal" Margin="6 3">
        <BoxContainer Orientation="Vertical" MinWidth="320" Margin="0 0 6 0">
            <BoxContainer Orientation="Horizontal">
                <Label Text="{Loc 'derelict-yard-balance'}" FontColorOverride="Silver"/>
                <Label Name="BalanceLabel"/>
            </BoxContainer>
            <Label Name="RankLabel" FontColorOverride="Silver"/>
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" Margin="0 4 0 0">
                <BoxContainer Name="VesselList" Orientation="Vertical" HorizontalExpand="True"/>
            </ScrollContainer>
            <Label Text="{Loc 'derelict-yard-leases'}" FontColorOverride="Silver" Margin="0 4 0 0"/>
            <BoxContainer Name="LeaseList" Orientation="Vertical" HorizontalExpand="True" MinHeight="80"/>
        </BoxContainer>
        <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalExpand="True">
            <Label Name="NameLabel" StyleClasses="LabelHeading"/>
            <RichTextLabel Name="DescriptionLabel" Margin="0 2"/>
            <PanelContainer VerticalExpand="True" HorizontalExpand="True" MinSize="400 360">
                <derelict:DerelictPreviewControl Name="Preview" VerticalExpand="True" HorizontalExpand="True"/>
            </PanelContainer>
            <BoxContainer Orientation="Horizontal">
                <Label Name="PriceLabel" HorizontalExpand="True"/>
                <Button Name="BuyButton" Text="{Loc 'derelict-yard-buy'}" Disabled="True"/>
            </BoxContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
