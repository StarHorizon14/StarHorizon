achievement-examine = [color=gold]Achievements:[/color] {$achievements}

cmd-addachievement-desc = Grants a player an achievement shown when examining any of their characters.
cmd-addachievement-help = Usage: addachievement <ckey> <achievement name>
cmd-removeachievement-desc = Removes an achievement from a player.
cmd-removeachievement-help = Usage: removeachievement <ckey> <achievement name>
cmd-achievements-desc = Lists a player's achievements.
cmd-achievements-help = Usage: achievements <ckey>

achievement-command-no-player = Player {$player} not found.
achievement-command-bad-name = The name must be between 1 and {$max} characters.
achievement-command-already-has = {$player} already has the achievement "{$name}".
achievement-command-not-found = {$player} doesn't have the achievement "{$name}".
achievement-command-added = Granted the achievement "{$name}" to {$player}.
achievement-command-removed = Removed the achievement "{$name}" from {$player}.
achievement-command-list = {$player}'s achievements: {$achievements}
achievement-command-list-empty = {$player} has no achievements.
achievement-command-hint-player = <ckey>
achievement-command-hint-name = <achievement name>
