cmd-miragelink-desc = Makes an entity show a mirage of the area around another entity.
cmd-miragelink-help = Usage: miragelink <border> <target> [<offsetX> <offsetY> <sizeX> <sizeY>]
cmd-miragelink-success = {$border} now shows a mirage of {$target}.
cmd-miragelink-hint-border = <border entity>
cmd-miragelink-hint-target = <target entity>
cmd-miragelink-hint-offset = [offset, tiles]
cmd-miragelink-hint-size = [size, tiles]
