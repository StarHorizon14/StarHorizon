ent-ShipTool = ship cutter
    .desc = A heavy battery powered plasma cutter for taking ships apart. Click a wall to cut it loose, or the seam between two floor tiles to cut along it. Use it in hand to switch to welding.

ship-tool-name-cut = ship cutter
ship-tool-name-weld = seam welder
ship-tool-desc-cut = A heavy battery powered plasma cutter for taking ships apart. Click a wall to cut it loose, or the seam between two floor tiles to cut along it. Use it in hand to switch to welding.
ship-tool-desc-weld = A heavy battery powered welder for joining two hulls edge to edge and welding shut the seams and cuts between tiles. Use it in hand to switch to cutting.

ship-cutter-cannot-cut = There is nothing to cut there.
ship-cutter-no-charge = The tool is out of charge.

ship-tool-status-cut = Mode: [color=cyan]cutting[/color]
ship-tool-status-weld = Mode: [color=orange]welding[/color]
