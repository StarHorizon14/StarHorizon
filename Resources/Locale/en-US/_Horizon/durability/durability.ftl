## Shared durability display

durability-examine-bar = Durability: [color={ $color }]{ $bar }[/color] { $percent }%
durability-status = Durability: [color={ $color }]{ $percent }%[/color]
durability-status-stalled = Durability: [color={ $color }]{ $percent }%[/color] [color=red]stalled { $seconds }s[/color]
durability-status-broken = Durability: [color=red]BROKEN[/color]

## Weapon wear

weapon-wear-examine-broken = [color=red]The weapon is broken and won't work until repaired.[/color]
weapon-wear-examine-unreliable = [color=orange]The weapon is worn and may malfunction.[/color]
weapon-wear-broken-popup = { CAPITALIZE(THE($weapon)) } breaks!
weapon-wear-broken-blocked = { CAPITALIZE(THE($weapon)) } is broken.
weapon-wear-jam-bolt = Malfunction! Rack the bolt.
weapon-wear-jam-stall = Malfunction! { CAPITALIZE(THE($weapon)) } stops working for a moment.
weapon-wear-stalled-blocked = { CAPITALIZE(THE($weapon)) } hasn't recovered from the malfunction yet.

weapon-wear-broken-name = broken { $baseName }
