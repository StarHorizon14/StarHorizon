// Фон интро появления: тёмно-зелёный экран, который искажается волнами,
// с несколькими движущимися полосками и помехами. Игру не сэмплирует.

uniform highp float Alpha; // общая непрозрачность фона

void fragment() {
    highp vec2 screenSize = vec2(1.0 / SCREEN_PIXEL_SIZE.x, 1.0 / SCREEN_PIXEL_SIZE.y);
    highp vec2 uv = FRAGCOORD.xy * SCREEN_PIXEL_SIZE;
    highp float aspect = screenSize.x / screenSize.y;

    // Искажение: медленные волны сдвигают картинку вбок и немного вверх-вниз.
    highp float warpX = sin(uv.y * 9.0 + TIME * 1.3) * 0.5 + sin(uv.y * 23.0 - TIME * 0.7) * 0.25;
    highp float warpY = sin(uv.x * 7.0 - TIME * 0.9) * 0.5;
    highp vec2 w = uv + vec2(warpX * 0.012, warpY * 0.006);

    // Переливающаяся тёмно-зелёная основа.
    highp float n = 0.5
        + 0.25 * sin(w.x * 6.0 * aspect + TIME * 0.4 + sin(w.y * 5.0 + TIME * 0.3) * 2.0)
        + 0.25 * sin(w.y * 8.0 - TIME * 0.5 + sin(w.x * 4.0 * aspect - TIME * 0.2) * 1.5);
    highp vec3 col = mix(vec3(0.004, 0.022, 0.013), vec3(0.03, 0.10, 0.055), n);

    // Несколько полосок разной толщины, которые ползут по экрану с разной скоростью.
    // Часть вверх, часть вниз, чтобы выглядело как неровная развёртка.
    for (int i = 0; i < 5; i++)
    {
        highp float fi = float(i);
        highp float speed = (0.05 + fi * 0.035) * (mod(fi, 2.0) < 0.5 ? 1.0 : -1.0);
        highp float width = 0.012 + fi * 0.011;
        highp float d = abs(fract(w.y - TIME * speed - fi * 0.21 + 0.5) - 0.5);
        highp float band = smoothstep(width, 0.0, d);
        col += vec3(0.10, 0.45, 0.24) * band * (0.10 + 0.03 * fi);
    }

    // Тонкие яркие полоски поверх.
    for (int j = 0; j < 3; j++)
    {
        highp float fj = float(j);
        highp float d = abs(fract(w.y + TIME * (0.11 + fj * 0.07) + fj * 0.37 + 0.5) - 0.5);
        col += vec3(0.25, 0.9, 0.5) * smoothstep(0.0025, 0.0, d) * 0.12;
    }

    // Помехи: рваные горизонтальные строки меняют яркость.
    highp float frame = floor(TIME * 8.0);
    highp float row = floor(uv.y * 70.0);
    highp float g = zRandom(vec2(row * 0.37, frame * 0.91)).x;
    col += vec3(0.05, 0.22, 0.12) * step(0.965, g) * (g - 0.9) * 6.0;

    // Развёртка и зерно.
    col *= 0.82 + 0.18 * sin(FRAGCOORD.y * 3.14159265);
    highp float grain = zRandom(FRAGCOORD.xy * SCREEN_PIXEL_SIZE + frame * 0.013).x - 0.5;
    col += grain * 0.05;

    // Виньетка и медленное мерцание без стробирования.
    highp vec2 dv = (uv - 0.5) * vec2(1.0, 0.8);
    col *= 1.0 - smoothstep(0.30, 0.85, length(dv)) * 0.7;
    col *= 0.96 + 0.04 * sin(TIME * 9.0);

    COLOR = vec4(col, Alpha);
}
